FROM alpine:3.21@sha256:87a4361f6c819618a6bafa2ed5228714cb0bb22195d2b49c95eb26799990128a

RUN apk add --no-cache --upgrade ca-certificates wget ffmpeg=6.1.2-r1

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

COPY deploy/docker/api-gateway-linux ./api-gateway
COPY config ./config
# The chain's deployment record (batch C): the registry's deployment identity is
# verified against it at startup, so an enabled registry without it fails startup
# instead of silently advertising a registration path it cannot honour.
COPY deployments ./deployments

RUN chown -R appuser:appgroup /app && chmod +x ./api-gateway

USER appuser

EXPOSE 8080 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["./api-gateway"]
