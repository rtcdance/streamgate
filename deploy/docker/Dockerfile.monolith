FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS builder

WORKDIR /app

RUN apk add --no-cache git make

ENV GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -tags nats_integration -a -trimpath -installsuffix cgo -o streamgate ./cmd/monolith/streamgate

FROM alpine:3.21@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507

RUN apk add --no-cache --upgrade ca-certificates ffmpeg=6.1.2-r1 wget

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

COPY --from=builder /app/streamgate .
COPY --from=builder /app/h5-demo ./h5-demo
# Config files, like every other service image (Dockerfile.api-gateway etc.).
# Without them this image ran on compiled-in defaults only: non-env values such
# as web3.anvil_demo_contract silently disappeared, the demo NFT minter was
# disabled, and the full-chain acceptance could not mint on the monolith — the
# image under acceptance therefore exercised a different configuration than the
# artifact that gets deployed.
COPY --from=builder /app/config ./config

RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 8080 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:8080/health || exit 1

ENTRYPOINT ["./streamgate"]
