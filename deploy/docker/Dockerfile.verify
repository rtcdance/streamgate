# syntax=docker/dockerfile:1.4@sha256:9ba7531bd80fb0a858632727cf7a112fbfd19b17e94c4e84ced81e24ef1a0dbc
# ============================================================
# StreamGate verification toolchain image
# ============================================================
# One image carrying every tool the acceptance stages need — Go, Foundry
# (forge/cast/anvil), FFmpeg, Node + Playwright deps, golangci-lint — so a
# clean checkout can be verified without any host toolchain.
#
# The candidate source is copied in once; every VERIFY_STAGE runs against this
# same image contents (no per-stage rebuild).
#
# Build:  docker build -f deploy/docker/Dockerfile.verify -t streamgate-verify:local .
# Use:    make verify-docker VERIFY_STAGE=unit
# ============================================================
# Foundry binaries (forge / cast / anvil / chisel) are copied out of the pinned
# upstream image rather than fetched by foundryup. foundryup downloads its
# tarball from github.com/foundry-rs/foundry/releases →
# release-assets.githubusercontent.com, which is unreachable from some networks
# (it timed out here) even though the very same binaries are served fine from
# ghcr.io. Sourcing them from an image removes a network dependency from the
# build — the same fix class as the solc prewarm below (a code gate must not
# become a network gate) — and pins the exact forge version the CI image records
# (1.8.5). Override FOUNDRY_IMAGE to build against another version.
ARG FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry:v1.8.5@sha256:32c8ea9ef052a440cb1620175987a3f49eff8b068a0c6a3d09ebf7f5f9a0e043
FROM ${FOUNDRY_IMAGE} AS foundry
FROM docker:28.4.0-cli@sha256:6a73c9433f2ba4279815be1e60f5739288b939dda1e48151d8c393537802de37 AS dockercli
FROM node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS nodejs

FROM golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c

ENV DEBIAN_FRONTEND=noninteractive
ENV DOCKER_BUILDKIT=1
ARG FFMPEG_VERSION=7:5.1.9-0+deb12u1

# System toolchain: ffmpeg for media, jq/curl/git for scripting, build-essential
# for cgo-dependent test paths, python3 for helper scripts.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg=${FFMPEG_VERSION} \
        jq \
        curl \
        git \
        ca-certificates \
        build-essential \
        python3 \
    && rm -rf /var/lib/apt/lists/*

# Node 22 + Playwright browser system dependencies (the H5 acceptance suite
# drives a real Chromium via `npm ci`).
COPY --from=nodejs /usr/local/ /usr/local/
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

# Foundry: forge / cast / anvil / chisel, copied from the pinned image above onto
# the default PATH (the login profile under `bash -lc` resets PATH to the Debian
# default, so /usr/local/bin is where every stage will find them).
COPY --from=foundry /usr/local/bin/forge /usr/local/bin/cast /usr/local/bin/anvil /usr/local/bin/chisel /usr/local/bin/

# Compile the exact lint version from its Go module, avoiding a mutable
# installer fetched from upstream HEAD.
SHELL ["/bin/bash", "-c"]
ARG GOLANGCI_LINT_VERSION=v2.12.2
ARG GOLANGCI_LINT_PROXY=https://goproxy.cn,direct
RUN set -euxo pipefail; \
    v="${GOLANGCI_LINT_VERSION}"; \
    GOBIN=/usr/local/bin GOPROXY="${GOLANGCI_LINT_PROXY}" \
      go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${v}"; \
    command -v golangci-lint; \
    golangci-lint version

# Stage scripts run under `bash -lc`, whose login profile resets PATH to the
# Debian default — that drops /usr/local/go/bin. The Foundry tools already live
# on /usr/local/bin (copied above); only the Go toolchain needs re-exporting from
# /etc/profile.d so every stage sees go/gofmt.
RUN printf 'export PATH=/usr/local/go/bin:$PATH\n' > /etc/profile.d/go-toolchain.sh

# Bake the solc the repo pins (contracts/foundry.toml: solc = "0.8.24") into
# Forge's svm cache, so a later `forge build` needs no network.
#
# Three deliberate choices:
#   * ABOVE `COPY . .` — a prewarm placed after the source copy re-runs on
#     EVERY commit (that copy invalidates its layer), turning a code gate into
#     a network gate. Above it, the layer is computed once and reused until
#     these lines change. (contracts/out and contracts/cache are gitignored, so
#     the image always compiles from source and always wants a compiler.)
#   * From binaries.soliditylang.org rather than forge's own fetch: forge pulls
#     solc from GitHub release assets, and raw.githubusercontent.com is
#     unreachable from some networks (it hung a build here for 20+ minutes).
#     The mirror's own list.json publishes the sha256, so the bytes are pinned
#     and verified — a reachable transport, not a weaker supply chain.
#   * Mandatory: an unavailable or unverified compiler fails the image build.
#     The controller defaults to linux/amd64 for this pinned solc binary.
#
# The layout is exactly the one forge creates and reads:
# ~/.svm/.global-version, ~/.svm/<version>/.lock, ~/.svm/<version>/solc-<version>.
ARG SOLC_VERSION=0.8.24
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64)  platform=linux-amd64; artifact=solc-linux-amd64-v0.8.24+commit.e11b9ed9; \
               sum=fb03a29a517452b9f12bcf459ef37d0a543765bb3bbc911e70a87d6a37c30d5f ;; \
      aarch64) platform=linux-arm64; artifact=solc-linux-arm64-v0.8.24+commit.e11b9ed9; \
               sum="" ;; \
      *)       platform=""; artifact=""; sum="" ;; \
    esac; \
    mkdir -p "/root/.svm/${SOLC_VERSION}"; \
    : > /root/.svm/.global-version; \
    : > "/root/.svm/${SOLC_VERSION}/.lock"; \
    if [ -n "$artifact" ] && [ -n "$sum" ] \
       && curl -fsSL --retry 3 --connect-timeout 15 --max-time 180 \
            -o "/root/.svm/${SOLC_VERSION}/solc-${SOLC_VERSION}" \
            "https://binaries.soliditylang.org/${platform}/${artifact}" \
       && echo "${sum}  /root/.svm/${SOLC_VERSION}/solc-${SOLC_VERSION}" | sha256sum -c -; then \
      chmod +x "/root/.svm/${SOLC_VERSION}/solc-${SOLC_VERSION}"; \
      echo "solc ${SOLC_VERSION} baked into ~/.svm from the solidity mirror (${artifact})"; \
    else \
      echo "ERROR: pinned solc ${SOLC_VERSION} is unavailable for $(uname -m)" >&2; \
      exit 1; \
    fi

WORKDIR /src
COPY go.mod go.sum ./

# Module downloads go straight to VCS by default: the build network cannot
# reach proxy.golang.org / sum.golang.org (github can), matching the host's
# GOPROXY=direct. Every module is still verified against the committed go.sum;
# GOSUMDB only matters for modules absent from it, which `go mod download`
# never fetches. Override with --build-arg GOPROXY=... on open networks.
ARG GOPROXY=direct
ENV GOPROXY=${GOPROXY}
ENV GOSUMDB=off

# Warm the module cache; contracts submodules must already be checked out
# (the runner runs `git submodule update --init --recursive` beforehand).
RUN go mod download
COPY . .
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
RUN set -euo pipefail; test "$(go env GOVERSION)" = go1.26.9 \
    && test "$(node --version)" = v22.23.3 \
    && test "$(docker compose version --short)" = 2.39.4 \
    && docker buildx version \
    && ffmpeg -version

CMD ["bash"]
