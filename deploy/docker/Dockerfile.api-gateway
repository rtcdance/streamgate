# Build stage
FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
ENV GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
RUN go mod download

# Copy source code
COPY . .

# Build the api-gateway service
RUN CGO_ENABLED=0 GOOS=linux go build -tags nats_integration -trimpath -installsuffix cgo -o api-gateway ./cmd/microservices/api-gateway

# Final stage
FROM alpine:3.21@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507

RUN apk add --no-cache --upgrade ca-certificates wget ffmpeg=6.1.2-r1

# Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/api-gateway .

# Copy config files
COPY --from=builder /app/config ./config

# Set ownership
RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 8080 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["./api-gateway"]
