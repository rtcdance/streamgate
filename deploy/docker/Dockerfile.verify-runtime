FROM alpine:3.21@sha256:87a4361f6c819618a6bafa2ed5228714cb0bb22195d2b49c95eb26799990128a
RUN apk add --no-cache ca-certificates wget ffmpeg=6.1.2-r1 \
    && addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
ARG BINARY_NAME
COPY deploy/docker/${BINARY_NAME}-linux ./service
COPY config ./config
COPY h5-demo ./h5-demo
# The chain's deployment record (batch C). The verify stack enables the
# registry (STREAMGATE_CONTENT_REGISTRY_ADDRESS is set), and an enabled registry
# verifies its deployment identity at startup — without this the app refuses to
# start instead of advertising a registration path it cannot honour.
COPY deployments ./deployments
RUN chown -R appuser:appgroup /app
USER appuser
EXPOSE 8080 9090
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=10 \
    CMD wget -q -O /dev/null http://localhost:8080/health || exit 1
CMD ["./service"]
