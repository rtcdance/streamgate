# StreamGate Environment Configuration
# Copy this file to .env and fill in your values

# === Database (Required) ===
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=streamgate
DATABASE_SSLMODE=disable
DATABASE_MAXCONNS=25

# === Redis (Required) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === Object Storage (Required) ===
STORAGE_TYPE=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESSKEY=minioadmin
STORAGE_SECRETKEY=minioadmin
STORAGE_BUCKET=streamgate
STORAGE_REGION=

# === NATS (Required for microservice mode) ===
NATS_URL=nats://localhost:4222

# === Consul (Required for microservice mode) ===
CONSUL_HOST=localhost
CONSUL_PORT=8500

# === Web3 / Blockchain (Required for NFT features) ===
WEB3_ETHEREUM_RPC=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
WEB3_SOLANA_RPC=https://api.mainnet-beta.solana.com
# WEB3_SOLANA_RPC_FALLBACK=https://solana-api.projectserum.com

# === Auth (Required - MUST change in production) ===
AUTH_JWT_SECRET=streamgate-dev-secret
# Comma-separated list for key rotation: first is signing key, rest verify only
# AUTH_JWT_SECRETS=new-secret,old-secret

# === gRPC (Optional, TLS) ===
# GRPC_TLS_ENABLED=false
# GRPC_TLS_CERT=/path/to/cert.pem
# GRPC_TLS_KEY=/path/to/key.pem

# === Rate Limiting ===
# Per-wallet rate limit (requests per minute)
# WALLET_RATE_LIMIT=10

# === Monitoring (Optional) ===
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# === Environment ===
STREAMGATE_ENV=development

# === StreamGate service credentials (docker-compose.fullchain.yml) ===
# The compose stack and the config loader bind these STREAMGATE_* vars via
# viper.BindEnv; the config/*.yaml placeholders below only name them.
# LOCAL-ONLY defaults — production injects real secrets via a secret manager.
STREAMGATE_DB_PASSWORD=streamgate_dev_password
STREAMGATE_STORAGE_ACCESS_KEY=minioadmin
STREAMGATE_STORAGE_SECRET_KEY=minioadmin
STREAMGATE_JWT_SECRET=dev-secret-key-not-for-production
# Anvil demo contracts (leave CONTENT_REGISTRY_ADDRESS empty to disable
# on-chain content registration)
# ANVIL_DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# CONTENT_REGISTRY_ADDRESS=
